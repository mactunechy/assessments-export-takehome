<h1><%= current_company.name %> dashboard</h1>
<%= button_to "Log out", session_path, method: :delete %>
<form id="export-form">
  <input type="date" name="from" required>
  <input type="date" name="to" required>
  <select name="status">
    <option value="">Any</option>
    <% Assessment::STATUSES.each do |s| %><option value="<%= s %>"><%= s.humanize %></option><% end %>
  </select>
  <button>Export CSV</button>
  <span id="export-status" role="status" aria-live="polite"></span>
</form>
<form method="get">
  <input name="status" placeholder="status" value="<%= params[:status] %>">
  <input type="date" name="from" value="<%= params[:from] %>">
  <input type="date" name="to" value="<%= params[:to] %>">
  <button>Filter</button>
</form>
<p>Total <%= @total %> · Completed <%= @counts["completed"] %> · Pending <%= @counts["pending"] %></p>
<table>
  <tr><th>Employee</th><th>Status</th><th>Score</th><th>Created</th></tr>
  <% @assessments.each do |a| %>
    <tr><td><%= a.employee.name %></td><td><%= a.status %></td><td><%= score_label(a) %></td><td><%= a.created_at.to_date %></td></tr>
  <% end %>
</table>
<p>
  <%= link_to "Prev", params.permit(:status, :from, :to).merge(page: @page - 1) if @page > 1 %>
  Page <%= @page %>
  <%= link_to "Next", params.permit(:status, :from, :to).merge(page: @page + 1) if @has_next %>
</p>
